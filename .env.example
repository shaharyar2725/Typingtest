# TypeFlow — Environment Variables Reference
# Copy to .env.local for local development. NEVER commit .env.local.

# ─────────────────────────────────────────────────────────────────
# API SERVER  (artifacts/api-server)
# ─────────────────────────────────────────────────────────────────

# Neon PostgreSQL — POOLED connection string (used at runtime by the app)
# From: Neon Console → Connection Details → Pooled connection
# The hostname must contain "-pooler" for serverless connection reuse.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon PostgreSQL — DIRECT connection string (used only by drizzle-kit for migrations)
# Same project, but WITHOUT "-pooler" in the hostname.
# PgBouncer (the pooler) blocks DDL statements; the direct URL bypasses it.
DIRECT_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Comma-separated list of allowed CORS origins — no trailing slash.
# Production: set to your Vercel frontend domain(s).
# Development: leave empty to allow all origins.
ALLOWED_ORIGINS=https://typeflow.vercel.app

# ─────────────────────────────────────────────────────────────────
# FRONTEND  (artifacts/typing)
# ─────────────────────────────────────────────────────────────────

# Absolute base URL of the deployed API server — no trailing slash.
# Production: set to your Vercel API project URL.
# Development: leave empty so fetch() uses relative URLs (Replit routing handles it).
VITE_API_BASE_URL=https://typeflow-api.vercel.app

# ─────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT ONLY (not used on Vercel)
# ─────────────────────────────────────────────────────────────────
PORT=19991
BASE_PATH=/
